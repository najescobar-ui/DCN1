    {
      "name": "4 · Carga (usar con Collection Runner)",
      "description": "Correr esta carpeta en el Collection Runner con, por ejemplo, 200 iteraciones. Después '5 · Verificar' muestra cuántos llegaron.",
      "item": [
        {
          "name": "Publicar mensaje",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/mensajeria/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "mensajeria",
                "messages"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"exchange\": \"{{exchange}}\",\n  \"routingKey\": \"{{cola}}\",\n  \"cuerpo\": \"{\\\"iteracion\\\": {{iteracion}}, \\\"id\\\": \\\"{{$randomUUID}}\\\"}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"responde en menos de 2 s\", () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set(\"iteracion\", pm.info.iteration + 1);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5 · Verificar",
      "description": "",
      "item": [
        {
          "name": "Mensajes en la cola",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/mensajeria/queues/{{cola}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "mensajeria",
                "queues",
                "{{cola}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "console.log(\"mensajes en la cola:\", pm.response.json().mensajes);",
                  "pm.test(\"llegaron mensajes (el contador tarda ~5 s)\", () => pm.expect(pm.response.json().mensajes).to.be.above(0));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// La API de management de RabbitMQ actualiza sus contadores cada ~5 s.",
                  "setTimeout(() => {}, 10000);"
                ]
              }
            }
          ]
        },
        {
          "name": "Mensaje inválido a las DLQ reales",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/mensajeria/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "mensajeria",
                "messages"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"exchange\": \"pedidos.eventos\",\n  \"routingKey\": \"pedido.carga\",\n  \"cuerpo\": \"esto no es un evento\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Los consumidores de notificaciones y auditoría lo rechazan sin reintento: aparece en notificaciones.pedidos.dlq y auditoria.eventos.dlq."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 202\", () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver DLQ de notificaciones",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/mensajeria/queues/notificaciones.pedidos.dlq",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "mensajeria",
                "queues",
                "notificaciones.pedidos.dlq"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Mensajes no entregados (listeners de DLQ)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// El listener de la DLQ registra el mensaje un instante después del NACK.",
                  "setTimeout(() => {}, 3000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const ultimo = pm.response.json()[0];",
                  "pm.test(\"el mensaje inválido quedó registrado con motivo rejected\", () => pm.expect(ultimo.motivo).to.eql(\"rejected\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/mensajes-fallidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "mensajes-fallidos"
              ]
            }
          }
        }
      ]
    },
