            "url": {
              "raw": "{{baseUrl}}/api/mensajeria/exchanges",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "mensajeria",
                "exchanges"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{exchange}}\",\n  \"tipo\": \"DIRECT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear cola quorum con DLQ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/mensajeria/queues",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "mensajeria",
                "queues"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{cola}}\",\n  \"tipo\": \"QUORUM\",\n  \"conDlq\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"queda enlazada al DLX\", () => pm.expect(pm.response.json().argumentos[\"x-dead-letter-exchange\"]).to.eql(\"pedidos.dlx\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear binding",
