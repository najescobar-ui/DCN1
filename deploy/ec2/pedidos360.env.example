# Copy to /opt/pedidos360/pedidos360.env on the EC2 instance (chmod 600). Never commit the real file.
COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Each microservice uses its own database on the same RDS PostgreSQL instance.
# DB_URL is set per service in the systemd drop-ins (see deploy.sh).
DB_USER=pedidos360
DB_PASSWORD=change-me

PRODUCTOS_URL=http://localhost:8081
PEDIDOS_URL=http://localhost:8082
# Microservicios de mensajería (IP privada de la EC2 de RabbitMQ); el BFF les reenvía las rutas.
NOTIFICACIONES_URL=http://10.0.0.20:8084
MENSAJERIA_URL=http://10.0.0.20:8083
# Streaming: los tres brokers Kafka (listener EXTERNAL, IP privada de la EC2 de streaming) y los microservicios
# de streaming, a los que el BFF reenvía /api/analitica y /api/streaming.
KAFKA_BOOTSTRAP_SERVERS=10.0.0.30:9092,10.0.0.30:9093,10.0.0.30:9094
ANALITICA_URL=http://10.0.0.30:8085
STREAMING_URL=http://10.0.0.30:8086
