# Copy to /opt/pedidos360/pedidos360.env on the EC2 instance (chmod 600). Never commit the real file.
COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Each microservice uses its own database on the same RDS PostgreSQL instance.
# DB_URL is set per service in the systemd drop-ins (see deploy.sh).
DB_USER=pedidos360
DB_PASSWORD=change-me

PRODUCTOS_URL=http://localhost:8081
PEDIDOS_URL=http://localhost:8082
